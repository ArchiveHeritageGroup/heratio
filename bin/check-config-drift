#!/bin/bash
#===============================================================================
# Heratio - Host-Config Drift Check
#===============================================================================
# Compares the host configuration tracked in this repo against what is actually
# installed on the box, and reports anything that has diverged.
#
# Why this exists (#1465): the repo already tracked deploy/ and
# config/cantaloupe/, but nothing checked the copies still matched. They drifted
# in BOTH directions - the tracked nginx IIIF snippet still used
# `proxy_set_header Host $host`, which drops the port and would have
# reintroduced a blank-viewer bug on any non-443 instance, while the live copy
# had lost the timeouts and CORS headers the template carried. Neither was
# correct and no one could tell, because comparing them was a manual job nobody
# did.
#
# Exit codes:
#   0 — every tracked file matches its installed counterpart (or is absent here)
#   1 — drift found
#
# Usage:
#   ./bin/check-config-drift            # summary
#   ./bin/check-config-drift --diff     # summary + unified diff of each drift
#   ./bin/check-config-drift --quiet    # exit code only, for cron
#   ./bin/check-config-drift --notify   # on drift, raise a Workbench notification
#
# A file that is not installed on this host is SKIPPED, not failed: not every
# box runs every vhost. Only a file present in both places and differing counts
# as drift.
#
# Copyright (C) 2026 Johan Pieterse
# Plain Sailing Information Systems
# License: AGPL-3.0-or-later
#===============================================================================
set -uo pipefail
cd "$(dirname "$0")/.." || { echo "ERROR [check-config-drift]: cannot change to repo root" >&2; exit 2; }
ROOT="$(pwd)"

SHOW_DIFF=0
QUIET=0
NOTIFY=0
for arg in "$@"; do
    case "$arg" in
        --diff)  SHOW_DIFF=1 ;;
        --quiet) QUIET=1 ;;
        --notify) NOTIFY=1 ;;
        -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    esac
done

say() { [ "$QUIET" = "1" ] || echo -e "$@"; }

# --- error handling --------------------------------------------------------
# `set -e` is deliberately NOT used: diff returns non-zero on a genuine
# difference and the comparison relies on that. Fallible operations are trapped
# explicitly, at each point they occur, and reported through one central sink.
SELF="$(basename "$0")"
declare -a TMPS=()
cleanup() { local t; for t in "${TMPS[@]:-}"; do [ -n "${t:-}" ] && rm -f "$t" 2>/dev/null; done; }
report_error() {
    # Always to stderr, regardless of --quiet.
    echo -e "\033[31mERROR\033[0m [$SELF] $*" >&2
    # TODO(callhub): once the CallHub error API is available (requested from the
    # Workbench/CallHub session) POST "$*" here so failures also surface on CallHub.
}
trap "cleanup" EXIT
trap 'report_error "interrupted by signal"; cleanup; exit 130' INT TERM

DRIFT=0
CHECKED=0
SKIPPED=0
UNREADABLE=0
DRIFTED_LIST=""

# Notification sink and de-dup state, defined once so both the drift and the
# recovery paths use them. STATE holds the signature of the last drift we
# alerted on, so a persistent drift on a schedule is not re-reported every run.
INBOX="${WORKBENCH_NOTIFICATIONS_INBOX:-/var/spool/workbench/notifications}"
STATE="${CONFIG_DRIFT_STATE:-/var/spool/workbench/.heratio-config-drift.last}"

# ---------------------------------------------------------------------------
# Manifest: <repo path>|<installed path>|<mode>
#
#   exact    - byte-for-byte mirror; any difference is drift
#   rendered - repo copy is a template; {{PLACEHOLDER}}s are substituted from
#              the RENDER map below before comparing
#   inform   - structurally different by design; reported for eyeballing only
#              and never fails the check
# ---------------------------------------------------------------------------
MANIFEST="
deploy/sbin/heratio-deploy.sh|/usr/local/sbin/heratio-deploy.sh|exact
deploy/sbin/heratio-demo-reset.sh|/usr/local/sbin/heratio-demo-reset.sh|exact
deploy/sbin/heratio-demo-snapshot.sh|/usr/local/sbin/heratio-demo-snapshot.sh|exact
deploy/cron/heratio-demo-reset|/etc/cron.d/heratio-demo-reset|exact
deploy/cron/heratio-config-drift|/etc/cron.d/heratio-config-drift|exact
deploy/cron/heratio-schedule|/etc/cron.d/heratio-schedule|exact
deploy/cron/ahg-facet-cache|/etc/cron.d/ahg-facet-cache|exact
deploy/cron/heratio-dev-facet-cache|/etc/cron.d/heratio-dev-facet-cache|exact
deploy/cron/ahg-discovery-prune|/etc/cron.d/ahg-discovery-prune|exact
deploy/cron/heratio-articles-persist|/etc/cron.d/heratio-articles-persist|exact
deploy/nginx/heratio.org.conf|/etc/nginx/sites-enabled/heratio.org.conf|exact
deploy/nginx/heratio.theahg.co.za.conf|/etc/nginx/sites-enabled/heratio.theahg.co.za.conf|exact
deploy/nginx/heratio-dev.conf|/etc/nginx/sites-enabled/heratio-dev.conf|exact
deploy/nginx/sasaarchive.theahg.co.za.conf|/etc/nginx/sites-enabled/sasaarchive.theahg.co.za.conf|exact
deploy/nginx/conf.d-heratio-browse-shed.conf|/etc/nginx/conf.d/heratio-browse-shed.conf|exact
# Host-wide nightly --all-databases dump. Not a Heratio script by ownership,
# but it writes the backups that carry Heratio's data (and every other app's),
# and its umask fix would otherwise be lost on a host rebuild with nothing to
# notice. Installed to /usr/local/bin, unlike the deploy/sbin scripts.
deploy/bin/mysql_full_dump.sh|/usr/local/bin/mysql_full_dump.sh|exact
deploy/bin/vm-backup.sh|/usr/local/sbin/vm-backup.sh|exact
deploy/cron/vm-backup|/etc/cron.d/vm-backup|exact
config/cantaloupe/nginx-iiif-snippet.conf|/etc/nginx/snippets/heratio-iiif.conf|rendered
config/cantaloupe/delegates.rb.template|/opt/cantaloupe-5.0.6/delegates.rb|inform
"

# Placeholder substitutions applied in `rendered` mode.
render_template() {
    sed -e "s|{{HTTP_PORT}}|8182|g" "$1"
}

say "==> host-config drift check"

while IFS='|' read -r repo live mode; do
    [ -z "${repo:-}" ] && continue
    # Skip comment lines. The manifest had no comment support, so a '# note'
    # line was read as a repo path and reported as "missing in repo" - the same
    # defect .locked-paths carried until it was fixed earlier today, where 45 of
    # 74 entries silently matched nothing because an inline comment was taken as
    # part of the path. A manifest that cannot be annotated gets annotated
    # anyway, and then lies about it.
    case "$repo" in \#*) continue ;; esac

    if [ ! -f "$ROOT/$repo" ]; then
        say "  \033[33mmissing in repo\033[0m  $repo"
        DRIFT=1
        continue
    fi
    if [ ! -f "$live" ]; then
        SKIPPED=$((SKIPPED + 1))
        say "  not installed here  $live"
        continue
    fi
    # An unreadable file is NOT drift. /usr/local/sbin/* is 0750 root, so an
    # unprivileged run cannot read it and diff fails - reporting that as drift
    # would make the check cry wolf every time it ran as www-data, and a check
    # that is routinely wrong gets ignored, which is worse than no check.
    if [ ! -r "$live" ]; then
        UNREADABLE=$((UNREADABLE + 1))
        say "  \033[33munreadable\033[0m      $live (run as root to compare)"
        continue
    fi

    CHECKED=$((CHECKED + 1))
    tmp=""
    case "$mode" in
        rendered) tmp="$(mktemp)" || { report_error "mktemp failed while rendering $repo"; continue; }; TMPS+=("$tmp"); render_template "$ROOT/$repo" > "$tmp" || { report_error "render_template failed for $repo"; continue; }; src="$tmp" ;;
        *)        src="$ROOT/$repo" ;;
    esac

    if diff -q "$src" "$live" >/dev/null 2>&1; then
        say "  \033[32mok\033[0m              $repo"
    elif [ "$mode" = "inform" ]; then
        # Expected to differ: delegates.rb is generated per host and then
        # MERGED with every other instance's entry, so it will never equal the
        # single-entry template. Shown so a structural change is still noticed.
        say "  \033[36minfo (differs by design)\033[0m  $repo"
    else
        say "  \033[31mDRIFT\033[0m           $repo  <->  $live"
        DRIFT=1
        DRIFTED_LIST="${DRIFTED_LIST},$(basename "$repo")"
        if [ "$SHOW_DIFF" = "1" ]; then
            diff -u "$src" "$live" | sed 's/^/      /'
        fi
    fi
    [ -n "$tmp" ] && rm -f "$tmp"
done <<< "$MANIFEST"

say ""
if [ "$DRIFT" = "1" ]; then
    say "\033[31mdrift found\033[0m - reconcile before it becomes a surprise."
    say "  the repo copy is the one that survives a host rebuild; the live copy"
    say "  is the one that is actually working. Decide which is right, then make"
    say "  them match - do not assume the repo is correct."

    # Cron here runs with MAILTO="" by convention, so a scheduled run would
    # otherwise report drift to nobody. Drop it on the Workbench notification
    # bus instead, which is the surface an operator actually watches.
    if [ "$NOTIFY" = "1" ] && [ -d "$INBOX" ]; then
        drifted="$(printf '%s' "$DRIFTED_LIST" | sed 's/^,//')"
        # de-dup: raise only when the drift signature changes, so a persistent
        # drift is not re-reported each run. The CallHub hook, when added, sits
        # inside this same gate so it cannot duplicate either.
        sig="$drifted"
        last=""; [ -r "$STATE" ] && last="$(cat "$STATE" 2>/dev/null)"
        if [ -n "$sig" ] && [ "$sig" = "$last" ]; then
            say "  drift unchanged since the last alert - not re-notifying"
        else
            tmp="$(mktemp)" || { report_error "mktemp failed - could not stage the drift notification"; exit 1; }
            TMPS+=("$tmp")
            if ! cat > "$tmp" <<JSON
{
  "username": "johan",
  "title": "Host config drift detected",
  "message": "Tracked host config no longer matches this box: ${drifted}. Run bin/check-config-drift --diff as root, then decide which side is right - the live copy is usually the one that works.",
  "eventType": "alert"
}
JSON
            then
                report_error "failed to write the drift notification payload"
                exit 1
            fi
            # mktemp creates 0600; the watcher runs as the service account and
            # cannot read that, so an un-chmod'd drop is quarantined unread.
            chmod 644 "$tmp" || report_error "chmod 644 failed - the watcher may be unable to read the notification"
            dest="$INBOX/config-drift-$(date +%Y%m%d-%H%M%S).json"
            if mv "$tmp" "$dest" 2>/dev/null && [ -r "$dest" ]; then
                say "  notification staged on the Workbench bus ($dest)"
                say "  (delivery is asynchronous - this confirms the drop landed readable, not that the watcher has consumed it)"
                printf '%s\n' "$sig" > "$STATE" 2>/dev/null || report_error "could not record de-dup state at $STATE - may re-alert next run"
            else
                report_error "could not place the drift notification in $INBOX (move or read-back failed)"
            fi
        fi
    fi
    exit 1
fi

msg="\033[32mno drift\033[0m ($CHECKED compared, $SKIPPED not installed here"
[ "$UNREADABLE" -gt 0 ] && msg="$msg, $UNREADABLE unreadable - rerun as root for full cover"
say "$msg)"
if [ "$NOTIFY" = "1" ] && [ -f "$STATE" ]; then
    rm -f "$STATE" 2>/dev/null && say "  (a previously alerted drift has cleared - alert state reset)"
fi
exit 0
