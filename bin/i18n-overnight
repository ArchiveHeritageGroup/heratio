#!/bin/bash
#===============================================================================
# Heratio - overnight UI translation fill (heratio#1510, #1416)
#
# Fills missing UI strings through the AI gateway LLM route, off-peak only, in
# the order agreed on 8 Oct 2026: the priority locales first, then the other
# widely used ones, then the South African languages, then low-resource ones.
# Each night resumes where the last stopped (filled strings are skipped), and
# the run stops at 06:00 so the GPU node is free in working hours.
#
# eDerma's card reading (qwen2.5vl:7b) has priority on the GPU (Johan, 16 Oct
# 2026): before each batch the fill waits while that model is loaded, and it
# pauses 10 s after each batch so a queued eDerma call gets the card first.
#
# Afrikaans is not here: the LLM must not seed it (heratio#1410); it is filled
# by ahg:translation-mt-batch af through the gateway's translation model.
#
# Writes lang/*.json and lang/_meta.json in this checkout only. Releasing the
# filled files is a separate, deliberate step.
#===============================================================================
set -uo pipefail
cd "$(dirname "$0")/.."

LOCALES="ar,fr,pt_BR,es,de,pt,zh,nl,it,ru,ja,ko,tr,pl,sv,he,uk,fa,id,vi,th,el,cs,ro,hu"
LOCALES="$LOCALES,mk,cy,bs,hr,sr,ca,ca@valencia,gl,sl,de_CH,de_AT,eu,is,ka,ta,uz,et,fil,ga,nb,sk,sq,ur"
LOCALES="$LOCALES,kj,umb,khi,am"
# The southern African languages are not in the LLM list: on 9 Nov 2026
# qwen3:8b gave no usable Zulu (0 of 192 accepted). zu, xh, ts and sn are
# filled by the gateway's opus-mt route instead (sampled first, native review
# to follow); ss, tn, st, nso, ve, nr and nd wait for a model that handles them
# (opus-mt has none, or returns nonsense for them).
MT_LOCALES="zu xh ts sn"

LOG="storage/logs/i18n-overnight-$(date +%Y-%m-%d).log"
echo "$(date '+%F %T') start" >> "$LOG"
# I18N_MODEL picks the gateway model, and with it the node: the gateway routes
# by model (OLLAMA_MODEL_AFFINITY; since 9 Nov 2026 qwen3:8b goes to .115, the
# default 27B to .76). I18N_YIELD names the models that have the GPU first;
# set it empty when the fill runs on another node than eDerma's qwen2.5vl.
# I18N_BATCH sets the strings per model call (default 40); 20 keeps the slow
# scripts (Georgian, Tamil, Welsh, Irish) under the gateway's 600 s limit.
YIELD=${I18N_YIELD-qwen2.5vl:7b}
# opus-mt first, not alongside: both commands rewrite lang/_meta.json. It
# only fills strings that are still empty, so once a language is done this
# costs nothing.
for l in $MT_LOCALES; do php artisan ahg:translation-mt-batch "$l" --skip=en,af --heratio-only=false >> "$LOG" 2>&1; done
php artisan ahg:translation-llm-fill "$LOCALES" --model="${I18N_MODEL:-qwen3.6:27b}" --until="${I18N_UNTIL:-06:00}" --batch="${I18N_BATCH:-40}" --pause=10 ${YIELD:+--yield-to="$YIELD"} >> "$LOG" 2>&1
echo "$(date '+%F %T') end rc=$?" >> "$LOG"
