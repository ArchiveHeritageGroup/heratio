<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         requireCoverageMetadata="false"
         beStrictAboutCoverageMetadata="false"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="false"
         failOnWarning="false"
>
    <testsuites>
        <!-- Primary application tests -->
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        
        <!-- Critical path tests - always required, cannot be skipped -->
        <testsuite name="CriticalPath">
            <directory>tests/CriticalPath</directory>
        </testsuite>

        <!-- Package-level tests -->
        <!--
             Every package, by glob. This was a hand-maintained list of 13
             directories, and a package whose tests were not on it simply never
             ran in CI: 26 packages with real tests were invisible, ahg-privacy
             among them, so the 26 tests written for the PII scan criteria at
             v1.154.710 protected nothing until v1.154.712. Only the "All" suite
             globbed, and All was itself broken (see its excludes), so nothing
             ran them. A list that has to be updated by hand to keep coverage is
             a list that silently loses coverage; the glob cannot.

             The two exclusions are the same ones All carries, for the same
             reasons - see the comments there.
        -->
        <testsuite name="Package">
            <directory>packages/*/tests</directory>
            <exclude>packages/ahg-z3950/tests</exclude>
            <exclude>packages/ahg-mva-claims/tests</exclude>
        </testsuite>

        <!-- All tests combined -->
        <testsuite name="All">
            <directory>tests</directory>
            <directory>packages/*/tests</directory>
            <!-- ahg-z3950 ships incomplete: Z3950ServerService constructor +
                 package-header/init-options wire format need a redesign
                 (issue #1135). BerEncoder itself is fixed and correct, but the
                 server-service + header tests fail until #1135 lands. Excluded
                 here so the build is not red on known-incomplete work; remove
                 this line when #1135 is resolved. -->
            <exclude>packages/ahg-z3950/tests</exclude>
            <!-- ahg-mva-claims is not a Heratio package. On instances that
                 develop it, packages/ahg-mva-claims is a symlink into a
                 separate application (composer.json carries the requirement
                 per-instance and is skip-worktree, so it never commits), and
                 the glob above follows the symlink. Its tests extend
                 AhgMvaClaims\Tests\TestCase, which lives in that package's
                 autoload-dev and a path repository does not merge, so building
                 the suite aborts with "Class not found" before a single test
                 runs - taking the whole All suite with it. That is why the 43
                 ahg-privacy tests sat unrun until v1.154.712: All was the only
                 suite that globbed them, and All had not worked in months.
                 PHPUnit ignores an exclude path that does not exist, so this
                 line is inert on instances without the symlink. -->
            <exclude>packages/ahg-mva-claims/tests</exclude>
        </testsuite>
    </testsuites>

    <!-- Source coverage configuration -->
    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Console</directory>
            <directory>app/Exceptions</directory>
            <directory>app/Http/Middleware</directory>
            <directory>app/Providers</directory>
        </exclude>
    </source>

    <!-- Environment configuration for testing -->
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="heratio_test"/>
        <env name="DB_USERNAME" value="heratio_test"/>
        <env name="DB_PASSWORD" value="H3ratio_Test!Local"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="COVERAGE_MIN_APP" value="50"/>
        <env name="COVERAGE_MIN_PACKAGES" value="30"/>
    </php>

    <!-- Coverage thresholds are enforced via CI script, not PHPUnit directly -->
</phpunit>
