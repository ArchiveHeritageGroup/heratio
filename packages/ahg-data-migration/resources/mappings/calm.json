{
  "source": "calm",
  "label": "Axiell Calm",
  "version": 1,
  "signature": { "required": ["RefNo", "AltRefNo"], "supporting": ["Level", "AdminHistory"] },
  "reference_field": "RefNo",
  "parent_field": "ParentRefNo",
  "delimiter": "/",
  "record_type": { "field": "RecordType", "taxonomy": "source_record_type_calm" },
  "fields": {
    "RefNo": { "target": "identifier" },
    "ParentRefNo": { "target": "hierarchy" },
    "RecordType": { "target": "hierarchy" },
    "AltRefNo": { "target": "alternative_identifier" },
    "Title": { "target": "title" },
    "Date": { "target": "event_date", "transforms": [{ "op": "parse_date" }] },
    "Level": { "target": "level", "transforms": [{ "op": "lookup", "taxonomy": "source_level_calm" }] },
    "Extent": { "target": "extent_and_medium" },
    "PhysicalDescription": { "target": "extent_and_medium" },
    "AdminHistory": { "target": "archival_history", "loss": "flattened", "reason": "Administrative history belongs on the creator's authority record; it is held on the description because catalogue rows do not say which creator it describes." },
    "CustodialHistory": { "target": "archival_history" },
    "Acquisition": { "target": "acquisition" },
    "CreatorName": { "target": "actor_creator", "transforms": [{ "op": "split", "separator": ";" }] },
    "Description": { "target": "scope_and_content" },
    "Appraisal": { "target": "appraisal" },
    "Accruals": { "target": "accruals" },
    "Arrangement": { "target": "arrangement" },
    "AccessConditions": { "target": "access_conditions" },
    "ClosedUntil": { "target": "access_conditions", "loss": "flattened", "reason": "A closure date becomes text in the access conditions; nothing enforces it automatically. Imported records stay Draft." },
    "Copyright": { "target": "reproduction_conditions" },
    "Language": { "target": "note_language", "loss": "flattened", "reason": "Calm holds language names, not ISO codes, so they are kept as a language note." },
    "PhysicalCharacteristics": { "target": "physical_characteristics" },
    "FindingAids": { "target": "finding_aids" },
    "RelatedMaterial": { "target": "related_units_of_description" },
    "PublicationNote": { "target": "note_publication" },
    "Location": { "target": "location_of_originals" },
    "Notes": { "target": "note_general" },
    "CatalogueStatus": { "target": null, "loss": "dropped", "reason": "Calm cataloguing status has no agreed mapping to description status." },
    "PersonName": { "target": "actor_person", "transforms": [{ "op": "split", "separator": ";" }] },
    "CorpName": { "target": "actor_corporate", "transforms": [{ "op": "split", "separator": ";" }] },
    "Subject": { "target": "term_subject", "transforms": [{ "op": "split", "separator": ";" }] },
    "Place": { "target": "term_place", "transforms": [{ "op": "split", "separator": ";" }] }
  }
}
