#!/bin/bash
#===============================================================================
# Heratio - Reset Test Database
#
# Rebuilds heratio_test FROM SOURCE, the same way CI builds it
# (.github/workflows/e2e-tests.yml, job laravel-tests):
#
#   1. drop and recreate the database
#   2. load database/core/0*.sql          (base schema)
#   3. heratio:install-bootstrap 1 and 2  (every package's install.sql)
#   4. load database/seeds/0*.sql         (taxonomies, settings, ACL)
#   5. php artisan migrate                (migration-only schema)
#   6. ahg:build-closure --all            (hierarchy closure tables)
#
# heratio#1547: this script used to clone the AtoM `archive` database, so the
# test database carried AtoM's schema and drifted 161 tables and 169 columns
# behind Heratio. Building from source means local tests run on the schema CI
# and fresh installs get. Afterwards, `php artisan heratio:test-db-diff` lists
# what a live database has that the source files do not create: each line is a
# gap to close in an install.sql or a migration, never in the test database.
#
# Usage: ./bin/reset-test-db     (from the repo it should build from)
#===============================================================================

set -euo pipefail

cd "$(dirname "$0")/.."

TARGET_DB="heratio_test"
TEST_USER="heratio_test"
TEST_PASS='H3ratio_Test!Local'   # matches phpunit.xml

# /root/.my.cnf on this host carries a stale password that shadows a plain
# `mysql -u root`, so read the working credentials from .env and bypass any
# defaults file. (See the mysql-defaults-file host note.)
strip_quotes() { sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'\$//"; }
DB_USER=$(sed -n 's/^DB_USERNAME=//p' .env | head -1 | strip_quotes)
DB_PASS=$(sed -n 's/^DB_PASSWORD=//p' .env | head -1 | strip_quotes)
DB_USER="${DB_USER:-root}"
export MYSQL_PWD="$DB_PASS"
MYSQL=(mysql --defaults-file=/dev/null -u "$DB_USER")

# Artisan against the test database with the admin credentials (the schema is
# loaded as that user). Run as www-data when invoked as root, so log files are
# not created root-owned.
artisan() {
    local runner=()
    [ "$(id -u)" = 0 ] && runner=(sudo -u www-data)
    "${runner[@]}" env APP_ENV=testing DB_DATABASE="$TARGET_DB" DB_USERNAME="$DB_USER" DB_PASSWORD="$DB_PASS" \
        php artisan "$@"
}

echo "Rebuilding ${TARGET_DB} from source..."
"${MYSQL[@]}" -e "DROP DATABASE IF EXISTS ${TARGET_DB}; CREATE DATABASE ${TARGET_DB} CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
"${MYSQL[@]}" -e "CREATE USER IF NOT EXISTS '${TEST_USER}'@'localhost' IDENTIFIED BY '${TEST_PASS}'; GRANT ALL PRIVILEGES ON ${TARGET_DB}.* TO '${TEST_USER}'@'localhost'; FLUSH PRIVILEGES;"

for f in database/core/0*.sql; do
    echo "  schema  $f"
    "${MYSQL[@]}" "$TARGET_DB" < "$f"
done

echo "  package install.sql (install-bootstrap passes 1 and 2)"
artisan heratio:install-bootstrap --pass=1 --no-interaction || true
artisan heratio:install-bootstrap --pass=2 --no-interaction || true

for f in database/seeds/0*.sql; do
    echo "  seed    $f"
    "${MYSQL[@]}" "$TARGET_DB" < "$f" || echo "  (seed $f returned non-zero, continuing)"
done

echo "  migrations"
artisan migrate --force

echo "  closure tables"
artisan ahg:build-closure --all

echo "Done. ${TARGET_DB} is built from source. Drift against a live database: php artisan heratio:test-db-diff"
